---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const writing = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

// Group by year
const postsByYear = writing.reduce(
  (acc, post) => {
    const year = post.data.publishDate.getFullYear().toString();
    if (!acc[year]) {
      acc[year] = [];
    }
    acc[year].push(post);
    return acc;
  },
  {} as Record<string, typeof writing>
);

const years = Object.keys(postsByYear).sort((a, b) => Number(b) - Number(a));
---

<BaseLayout
  title="Writing & Notes"
  description="Articles, essays, and study notes on software development, web engineering, and cognitive science."
>
  <div class="max-w-3xl mx-auto">
    <header class="mb-10">
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-gray-900 dark:text-gray-100 mb-3">
        Writing & Notes
      </h1>
      <p class="text-lg text-gray-600 dark:text-gray-300">
        Articles, technical write-ups, and study notes.
      </p>
    </header>

    <div class="space-y-10">
      {
        years.map((year) => (
          <section>
            <h2 class="text-xl font-bold font-mono text-gray-400 dark:text-gray-500 mb-4 pb-2 border-b border-gray-100 dark:border-gray-800">
              {year}
            </h2>
            <div class="divide-y divide-gray-100 dark:divide-gray-800/60">
              {postsByYear[year].map((post) => (
                <article class="py-4 group">
                  <a
                    href={`/writing/${post.id}`}
                    class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2"
                  >
                    <h3 class="text-base font-semibold text-gray-900 dark:text-gray-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                      {post.data.title}
                    </h3>
                    <div class="flex items-center gap-2 shrink-0">
                      <span class="text-xs px-2 py-0.5 rounded bg-gray-100 dark:bg-slate-800 text-gray-600 dark:text-gray-400 capitalize">
                        {post.data.type}
                      </span>
                      <time
                        datetime={post.data.publishDate.toISOString()}
                        class="text-xs text-gray-400 dark:text-gray-500 font-mono"
                      >
                        {post.data.publishDate.toLocaleDateString('en-US', {
                          month: 'short',
                          day: 'numeric',
                        })}
                      </time>
                    </div>
                  </a>
                  {post.data.description && (
                    <p class="text-sm text-gray-500 dark:text-gray-400 mt-1 line-clamp-2">
                      {post.data.description}
                    </p>
                  )}
                </article>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </div>
</BaseLayout>
