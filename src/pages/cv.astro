---
import BaseLayout from '../layouts/BaseLayout.astro';

const skills = [
  { category: 'Languages', items: ['TypeScript', 'JavaScript (ES6+)', 'Python', 'HTML5 / CSS3', 'SQL'] },
  { category: 'Web & Frameworks', items: ['Astro', 'Node.js', 'Tailwind CSS', 'Vite', 'React'] },
  { category: 'Engineering & Tools', items: ['Git', 'Print CSS / Layout Engine', 'Data Pipelines', 'Automation'] },
  { category: 'Background', items: ['Cognitive Neuroscience', 'Experimental Design', 'Data Analysis'] },
];

const education = [
  {
    degree: 'M.Sc. Mind and Brain',
    institution: 'Humboldt-Universität zu Berlin',
    location: 'Berlin, Germany',
    period: '2017 – 2020',
    description: 'Interdisciplinary program spanning cognitive science, computational neuroscience, and philosophy of mind.',
  },
  {
    degree: 'B.Sc. Cognitive Psychology and Neuroscience',
    institution: 'Jacobs University',
    location: 'Bremen, Germany',
    period: '2013 – 2016',
    description: 'Foundations in neuroscience, statistical analysis, and empirical research methodology.',
  },
];
---

<BaseLayout
  title="About & Experience"
  description="About Zhiqi Kang — background, experience, technical stack, and education."
>
  <div class="max-w-3xl mx-auto space-y-12">
    <!-- Header -->
    <header class="pb-8 border-b border-gray-200 dark:border-gray-800">
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-gray-900 dark:text-gray-100 mb-4">
        About & Experience
      </h1>
      <p class="text-lg text-gray-600 dark:text-gray-300 leading-relaxed">
        I’m Zhiqi Kang, a developer and problem solver based in Berlin. With a background in cognitive neuroscience and research, I now channel that analytical mindset into crafting high-quality software, web tools, and minimal interfaces.
      </p>
    </header>

    <!-- Technical Skills Section -->
    <section>
      <h2 class="text-xl font-bold tracking-tight text-gray-900 dark:text-gray-100 mb-6">
        Technical Skills & Tools
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {
          skills.map((skillGroup) => (
            <div class="p-4 rounded-xl border border-gray-200/80 dark:border-gray-800 bg-white dark:bg-slate-900/40">
              <h3 class="text-xs font-mono font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400 mb-3">
                {skillGroup.category}
              </h3>
              <div class="flex flex-wrap gap-1.5">
                {skillGroup.items.map((item) => (
                  <span class="text-xs px-2.5 py-1 rounded-md bg-gray-100 dark:bg-slate-800 text-gray-700 dark:text-gray-300 font-mono">
                    {item}
                  </span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Education Section -->
    <section>
      <h2 class="text-xl font-bold tracking-tight text-gray-900 dark:text-gray-100 mb-6">
        Education
      </h2>
      <div class="space-y-6">
        {
          education.map((edu) => (
            <div class="relative pl-6 border-l-2 border-gray-200 dark:border-gray-800">
              <div class="absolute -left-[5px] top-1.5 w-2 h-2 rounded-full bg-blue-500"></div>
              <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 mb-1">
                <h3 class="text-base font-bold text-gray-900 dark:text-gray-100">
                  {edu.degree}
                </h3>
                <span class="text-xs font-mono text-gray-500 dark:text-gray-400">
                  {edu.period}
                </span>
              </div>
              <div class="text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                {edu.institution} — <span class="text-gray-500 dark:text-gray-400">{edu.location}</span>
              </div>
              <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
                {edu.description}
              </p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Connect / Contact Section -->
    <section class="p-6 rounded-2xl border border-gray-200/80 dark:border-gray-800 bg-gray-50/50 dark:bg-slate-900/30">
      <h2 class="text-lg font-bold text-gray-900 dark:text-gray-100 mb-2">
        Let’s Connect
      </h2>
      <p class="text-sm text-gray-600 dark:text-gray-300 mb-4">
        Feel free to reach out to collaborate on projects, discuss ideas, or say hello.
      </p>
      <div class="flex flex-wrap gap-3 text-sm">
        <a
          href="https://github.com/zhiqikang"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-slate-800 text-gray-800 dark:text-gray-200 font-medium hover:border-blue-500 transition-colors"
        >
          <span>GitHub</span>
          <span>↗</span>
        </a>
        <a
          href="https://twitter.com/zhiqikang"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-slate-800 text-gray-800 dark:text-gray-200 font-medium hover:border-blue-500 transition-colors"
        >
          <span>X / Twitter</span>
          <span>↗</span>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
