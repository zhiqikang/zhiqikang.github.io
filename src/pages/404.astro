---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found">
  <div class="max-w-md mx-auto text-center py-16">
    <div class="text-6xl font-extrabold font-mono text-blue-600 dark:text-blue-400 mb-4">
      404
    </div>
    <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-3">
      Page not found
    </h1>
    <p class="text-gray-600 dark:text-gray-400 mb-8 text-sm">
      The page you're looking for doesn't exist or may have been moved during our site redesign.
    </p>
    <a
      href="/"
      class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-medium text-sm transition-colors"
    >
      <span>← Return to Home</span>
    </a>
  </div>
</BaseLayout>
