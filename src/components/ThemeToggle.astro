---
// ThemeToggle.astro
import { Icon } from 'astro-icon/components';
---

<button
  id="theme-toggle"
  type="button"
  aria-label="Toggle color theme"
  class="relative inline-flex items-center justify-center p-2 rounded-lg text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500/50 transition-colors"
>
  <!-- Sun Icon (shown in dark mode) -->
  <Icon
    name="sun"
    id="theme-toggle-light-icon"
    class="w-5 h-5 hidden"
  />

  <!-- Moon Icon (shown in light mode) -->
  <Icon
    name="moon"
    id="theme-toggle-dark-icon"
    class="w-5 h-5 hidden"
  />
</button>

<script is:inline>
  function initTheme() {
    const themeToggleDarkIcon = document.getElementById('theme-toggle-dark-icon');
    const themeToggleLightIcon = document.getElementById('theme-toggle-light-icon');
    const themeToggleBtn = document.getElementById('theme-toggle');

    if (!themeToggleBtn || !themeToggleDarkIcon || !themeToggleLightIcon) return;

    const isDark = document.documentElement.classList.contains('dark');
    if (isDark) {
      themeToggleLightIcon.classList.remove('hidden');
      themeToggleDarkIcon.classList.add('hidden');
    } else {
      themeToggleDarkIcon.classList.remove('hidden');
      themeToggleLightIcon.classList.add('hidden');
    }

    // Remove any previous listener to avoid stacking
    themeToggleBtn.onclick = function () {
      const isCurrentlyDark = document.documentElement.classList.contains('dark');
      if (isCurrentlyDark) {
        document.documentElement.classList.remove('dark');
        localStorage.setItem('color-theme', 'light');
        themeToggleLightIcon.classList.add('hidden');
        themeToggleDarkIcon.classList.remove('hidden');
      } else {
        document.documentElement.classList.add('dark');
        localStorage.setItem('color-theme', 'dark');
        themeToggleDarkIcon.classList.add('hidden');
        themeToggleLightIcon.classList.remove('hidden');
      }
    };
  }

  // Run on initial load and on Astro page swaps if view transitions are used
  initTheme();
  document.addEventListener('astro:after-swap', initTheme);
</script>
