---
import ThemeToggle from './ThemeToggle.astro';

const navItems = [
  { href: '/projects', label: 'Projects' },
  { href: '/writing', label: 'Writing' },
  { href: '/cv', label: 'About / CV' },
];

const pathname = Astro.url.pathname;
---

<header class="sticky top-0 z-40 w-full backdrop-blur-md bg-background-light/80 dark:bg-background-dark/80 border-b border-gray-200/80 dark:border-gray-800/80 transition-colors">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <!-- Brand / Home Link -->
    <a
      href="/"
      class="group flex items-center gap-2 font-medium text-gray-900 dark:text-gray-100 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
    >
      <span class="w-2 h-2 rounded-full bg-blue-500 group-hover:scale-125 transition-transform"></span>
      <span class="tracking-tight font-semibold">Zhiqi Kang</span>
    </a>

    <!-- Navigation Links & Theme Toggle -->
    <div class="flex items-center gap-1 sm:gap-2">
      <nav class="flex items-center gap-1 sm:gap-2 text-sm font-medium">
        {
          navItems.map((item) => {
            const isActive = pathname === item.href || (item.href !== '/' && pathname.startsWith(item.href));
            return (
              <a
                href={item.href}
                class={`px-3 py-1.5 rounded-lg transition-colors ${
                  isActive
                    ? 'text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-950/40 font-semibold'
                    : 'text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-slate-800/60'
                }`}
              >
                {item.label}
              </a>
            );
          })
        }
      </nav>

      <div class="h-4 w-px bg-gray-200 dark:bg-gray-700 mx-1 sm:mx-2" aria-hidden="true"></div>

      <ThemeToggle />
    </div>
  </div>
</header>
