---
import { Icon } from 'astro-icon/components';

interface Props {
  title: string;
  description: string;
  tags?: string[];
  demoUrl?: string;
  githubUrl?: string;
  slug?: string;
  featured?: boolean;
  badge?: string;
}

const { title, description, tags = [], demoUrl, githubUrl, slug, featured = false, badge } = Astro.props;
---

<article
  class={`group relative flex flex-col justify-between p-6 rounded-2xl border transition-all duration-200 ${
    featured
      ? 'bg-gradient-to-br from-white via-white to-blue-50/40 dark:from-slate-900 dark:via-slate-900 dark:to-blue-950/20 border-blue-200 dark:border-blue-900/50 shadow-sm hover:shadow-md'
      : 'bg-white dark:bg-slate-900/60 border-gray-200/80 dark:border-gray-800 hover:border-gray-300 dark:hover:border-gray-700'
  }`}
>
  <div>
    <!-- Top row: Badge / Tag -->
    <div class="flex items-center justify-between gap-2 mb-3">
      <div class="flex items-center gap-2">
        {
          badge && (
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-100 text-blue-800 dark:bg-blue-900/50 dark:text-blue-300">
              {badge}
            </span>
          )
        }
        {
          featured && !badge && (
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800 dark:bg-amber-950/60 dark:text-amber-300">
              ★ Featured
            </span>
          )
        }
      </div>

      <!-- Quick Action Icons -->
      <div class="flex items-center gap-2 text-gray-400">
        {
          githubUrl && (
            <a
              href={githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="p-1 hover:text-gray-900 dark:hover:text-white transition-colors"
              title="View source on GitHub"
            >
              <Icon name="simple-icons:github" class="w-4 h-4" />
            </a>
          )
        }
        {
          demoUrl && (
            <a
              href={demoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="p-1 hover:text-blue-500 transition-colors"
              title="Open Live App"
            >
              <Icon name="external-link" class="w-4 h-4" />
            </a>
          )
        }
      </div>
    </div>

    <!-- Title -->
    <h3 class="text-lg font-bold text-gray-900 dark:text-gray-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors mb-2">
      {
        slug ? (
          <a href={`/projects/${slug}`}>
            {title}
            <span class="inline-block transition-transform group-hover:translate-x-0.5 ml-1 text-gray-400 text-sm">→</span>
          </a>
        ) : (
          title
        )
      }
    </h3>

    <!-- Description -->
    <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed mb-4">
      {description}
    </p>
  </div>

  <!-- Bottom: Tags & Actions -->
  <div>
    {
      tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5 mb-4">
          {tags.map((tag) => (
            <span class="text-xs px-2 py-0.5 rounded-md bg-gray-100 dark:bg-slate-800 text-gray-600 dark:text-gray-400 font-mono">
              {tag}
            </span>
          ))}
        </div>
      )
    }

    <div class="flex items-center gap-3 pt-3 border-t border-gray-100 dark:border-gray-800/80 text-xs font-medium">
      {
        demoUrl && (
          <a
            href={demoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 text-blue-600 dark:text-blue-400 hover:underline font-semibold"
          >
            <span>Live Demo</span>
            <Icon name="arrow-right" class="w-3.5 h-3.5" />
          </a>
        )
      }
      {
        slug && (
          <a
            href={`/projects/${slug}`}
            class="text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-200"
          >
            Read Case Study
          </a>
        )
      }
    </div>
  </div>
</article>
