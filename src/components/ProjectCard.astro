---
interface Props {
  title: string;
  description: string;
  tags?: string[];
  demoUrl?: string;
  githubUrl?: string;
  slug?: string;
  featured?: boolean;
  badge?: string;
}

const { title, description, tags = [], demoUrl, githubUrl, slug, featured = false, badge } = Astro.props;
---

<article
  class={`group relative flex flex-col justify-between p-6 rounded-2xl border transition-all duration-200 ${
    featured
      ? 'bg-gradient-to-br from-white via-white to-blue-50/40 dark:from-slate-900 dark:via-slate-900 dark:to-blue-950/20 border-blue-200 dark:border-blue-900/50 shadow-sm hover:shadow-md'
      : 'bg-white dark:bg-slate-900/60 border-gray-200/80 dark:border-gray-800 hover:border-gray-300 dark:hover:border-gray-700'
  }`}
>
  <div>
    <!-- Top row: Badge / Tag -->
    <div class="flex items-center justify-between gap-2 mb-3">
      <div class="flex items-center gap-2">
        {
          badge && (
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-100 text-blue-800 dark:bg-blue-900/50 dark:text-blue-300">
              {badge}
            </span>
          )
        }
        {
          featured && !badge && (
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800 dark:bg-amber-950/60 dark:text-amber-300">
              ★ Featured
            </span>
          )
        }
      </div>

      <!-- Quick Action Icons -->
      <div class="flex items-center gap-2 text-gray-400">
        {
          githubUrl && (
            <a
              href={githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="p-1 hover:text-gray-900 dark:hover:text-white transition-colors"
              title="View source on GitHub"
            >
              <svg class="w-4 h-4 fill-currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
              </svg>
            </a>
          )
        }
        {
          demoUrl && (
            <a
              href={demoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="p-1 hover:text-blue-500 transition-colors"
              title="Open Live App"
            >
              <svg class="w-4 h-4 fill-none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
              </svg>
            </a>
          )
        }
      </div>
    </div>

    <!-- Title -->
    <h3 class="text-lg font-bold text-gray-900 dark:text-gray-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors mb-2">
      {
        slug ? (
          <a href={`/projects/${slug}`}>
            {title}
            <span class="inline-block transition-transform group-hover:translate-x-0.5 ml-1 text-gray-400 text-sm">→</span>
          </a>
        ) : (
          title
        )
      }
    </h3>

    <!-- Description -->
    <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed mb-4">
      {description}
    </p>
  </div>

  <!-- Bottom: Tags & Actions -->
  <div>
    {
      tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5 mb-4">
          {tags.map((tag) => (
            <span class="text-xs px-2 py-0.5 rounded-md bg-gray-100 dark:bg-slate-800 text-gray-600 dark:text-gray-400 font-mono">
              {tag}
            </span>
          ))}
        </div>
      )
    }

    <div class="flex items-center gap-3 pt-3 border-t border-gray-100 dark:border-gray-800/80 text-xs font-medium">
      {
        demoUrl && (
          <a
            href={demoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 text-blue-600 dark:text-blue-400 hover:underline font-semibold"
          >
            <span>Live Demo</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>
        )
      }
      {
        slug && (
          <a
            href={`/projects/${slug}`}
            class="text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-200"
          >
            Read Case Study
          </a>
        )
      }
    </div>
  </div>
</article>
