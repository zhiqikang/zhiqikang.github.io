---
import BaseLayout from './BaseLayout.astro';
import { Icon } from 'astro-icon/components';

interface Props {
  title: string;
  description: string;
  publishDate: Date;
  updatedDate?: Date;
  tags?: string[];
  demoUrl?: string;
  githubUrl?: string;
  badge?: string;
}

const { title, description, publishDate, updatedDate, tags = [], demoUrl, githubUrl, badge } = Astro.props;

const formattedDate = publishDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
});
---

<BaseLayout title={title} description={description}>
  <article class="max-w-3xl mx-auto">
    <!-- Back to Projects link -->
    <a
      href="/projects"
      class="inline-flex items-center gap-1.5 text-sm font-medium text-gray-500 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 mb-8 transition-colors"
    >
      <Icon name="arrow-left" class="w-4 h-4" />
      <span>Back to all projects</span>
    </a>

    <!-- Header Section -->
    <header class="mb-10 pb-8 border-b border-gray-200 dark:border-gray-800">
      <div class="flex items-center gap-3 mb-3">
        {badge && (
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-100 text-blue-800 dark:bg-blue-900/50 dark:text-blue-300">
            {badge}
          </span>
        )}
        <span class="text-xs font-mono text-gray-500 dark:text-gray-400">{formattedDate}</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-gray-900 dark:text-gray-100 mb-4">
        {title}
      </h1>

      <p class="text-lg text-gray-600 dark:text-gray-300 leading-relaxed mb-6">
        {description}
      </p>

      <!-- Tags & Links -->
      <div class="flex flex-wrap items-center justify-between gap-4 pt-2">
        <div class="flex flex-wrap gap-2">
          {tags.map((tag) => (
            <span class="text-xs px-2.5 py-1 rounded-md bg-gray-100 dark:bg-slate-800 text-gray-700 dark:text-gray-300 font-mono">
              {tag}
            </span>
          ))}
        </div>

        <div class="flex items-center gap-3">
          {demoUrl && (
            <a
              href={demoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium transition-colors shadow-sm"
            >
              <span>Launch App</span>
              <Icon name="external-link" class="w-4 h-4" />
            </a>
          )}
          {githubUrl && (
            <a
              href={githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-slate-800 text-gray-700 dark:text-gray-200 text-sm font-medium transition-colors"
            >
              <Icon name="simple-icons:github" class="w-4 h-4" />
              <span>GitHub</span>
            </a>
          )}
        </div>
      </div>
    </header>

    <!-- Main MDX Content -->
    <div class="prose prose-slate dark:prose-invert max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-a:text-blue-600 dark:prose-a:text-blue-400 prose-img:rounded-xl">
      <slot />
    </div>
  </article>
</BaseLayout>
