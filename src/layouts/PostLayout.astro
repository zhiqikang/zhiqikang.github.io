---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  publishDate: Date;
  updatedDate?: Date;
  tags?: string[];
  type?: 'post' | 'note' | 'talk';
}

const { title, description, publishDate, updatedDate, tags = [], type = 'post' } = Astro.props;

const formattedDate = publishDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<BaseLayout title={title} description={description} article={true}>
  <article class="max-w-3xl mx-auto">
    <!-- Back to writing link -->
    <a
      href="/writing"
      class="inline-flex items-center gap-1.5 text-sm font-medium text-gray-500 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 mb-8 transition-colors"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
      </svg>
      <span>Back to all writing</span>
    </a>

    <!-- Header Section -->
    <header class="mb-10 pb-6 border-b border-gray-200 dark:border-gray-800">
      <div class="flex items-center gap-3 mb-3 text-xs text-gray-500 dark:text-gray-400">
        <time datetime={publishDate.toISOString()}>{formattedDate}</time>
        <span>•</span>
        <span class="capitalize px-2 py-0.5 rounded bg-gray-100 dark:bg-slate-800 text-gray-700 dark:text-gray-300 font-medium">
          {type}
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-gray-900 dark:text-gray-100 mb-4">
        {title}
      </h1>

      {description && (
        <p class="text-lg text-gray-600 dark:text-gray-300 leading-relaxed">
          {description}
        </p>
      )}

      {tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-4">
          {tags.map((tag) => (
            <span class="text-xs px-2 py-0.5 rounded bg-gray-100 dark:bg-slate-800 text-gray-600 dark:text-gray-400 font-mono">
              #{tag}
            </span>
          ))}
        </div>
      )}
    </header>

    <!-- Main Content -->
    <div class="prose prose-slate dark:prose-invert max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-a:text-blue-600 dark:prose-a:text-blue-400">
      <slot />
    </div>
  </article>
</BaseLayout>
